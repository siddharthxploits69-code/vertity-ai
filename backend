# ---------------------------------------------------------
# COMPLIANCE AUDIT ENGINE
# ---------------------------------------------------------

def evaluate_content_rules(text: str) -> List[FlaggedIssue]:
    """
    Evaluates text against deterministic brand rules.
    (In later rounds, enhance with Google Gemini API call for semantic tone checking)
    """
    flags = []
    text_lower = text.lower()

    for rule in BRAND_GUIDELINES:
        for forbidden in rule["forbidden_terms"]:
            if forbidden.lower() in text_lower:
                flags.append(FlaggedIssue(
                    guideline_id=rule["id"],
                    category=rule["category"],
                    severity="high" if rule["category"] == "Legal & Claims" else "medium",
                    original_text_snippet=forbidden,
                    explanation=f"Violates {rule['rule_name']}: {rule['description']}",
                    suggested_correction=rule["approved_alternatives"][0] if rule["approved_alternatives"] else "Remove or rephrase"
                ))
    
    return flags

